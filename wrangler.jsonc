// Cloudflare Workers: serve the static Next.js export in ./out.
// Having this file stops Wrangler from auto-detecting Next.js and installing
// the OpenNext adapter, which this static site does not need.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name shown in the Cloudflare dashboard.
  "name": "pro",
  "compatibility_date": "2026-09-01",
  // Runs before upload, so ./out always exists even if the dashboard build command is empty.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
